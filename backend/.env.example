# 复制为 backend/.env 后填写

# —— 数据库 ——
# 【前期推荐】本地 Docker Postgres（先跑 ./start.sh db 起容器）
DATABASE_URL="postgresql://postgres:dev@localhost:5432/fit"
# 【上线】换成任意 Postgres 即可（自建/Railway/Render/Neon/云RDS…非必须 Neon），只改这一行
# 托管商若要求 SSL，记得带 ?sslmode=require（如 Neon）
# DATABASE_URL="postgresql://用户:密码@主机:5432/库名?sslmode=require"

# —— AI ——
DEEPSEEK_API_KEY="sk-xxxxxxxx"

# —— 认证 ——
JWT_SECRET="换成一段够长的随机字符串"

# —— 服务 ——
PORT=3000
