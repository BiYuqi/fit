// Prisma schema — AI 减脂助手
// 与设计文档 V3 第 3 节、以及 seed_food_standard.ts 完全对齐。
//
// 用法:
//   npx prisma migrate dev --name init
//   连接配置在 prisma.config.ts（Prisma 7+），运行时通过 src/lib/prisma.ts 单例访问

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, vector] // pg_trgm 模糊匹配；vector 语义记忆 embedding
}

// ---------- 枚举 ----------
enum Gender {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum GoalType {
  cut
  maintain
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
}

enum PortionLabel {
  small
  medium
  large
  custom
}

// ---------- 用户 ----------
model User {
  id               String         @id @default(uuid())
  account          String         @unique
  password_hash    String
  name             String?
  gender           Gender?
  age              Int?
  height_cm        Decimal?
  weight_kg        Decimal?
  target_weight_kg Decimal?
  activity_level   ActivityLevel?
  goal_type        GoalType       @default(cut)
  daily_deficit    Int            @default(500)
  custom_tdee      Int?
  onboarded        Boolean        @default(false)
  created_at       DateTime       @default(now())

  food_records     FoodRecord[]
  exercise_records ExerciseRecord[]
  daily_summaries  DailySummary[]
  parse_logs       AiParseLog[]
  pending_records  PendingRecord[]
  chat_messages    ChatMessage[]
  traces           AiTrace[]
  token_usages     TokenUsage[]
  learning_events  LearningEvent[]
  weight_logs      WeightLog[]
  food_aliases     UserFoodAlias[]
  biases           UserBias[]
  memories          UserMemory[]
}

// ---------- 食物标准库（seed 导入的目标表）----------
model FoodStandard {
  id            String   @id @default(uuid())
  name          String
  aliases       String[] @default([])
  category      String
  edible_ratio  Float?   @default(1) // 食部，0~1
  calories_100g Float?
  protein_100g  Float?
  fat_100g      Float?
  carbs_100g    Float?
  fiber_100g    Float?
  is_composite  Boolean  @default(false)
  is_estimated  Boolean  @default(false)
  source        String   @default("composition_table") // composition_table | ai | ai_reviewed | manual
  created_at    DateTime @default(now())

  food_records    FoodRecord[]
  learning_events LearningEvent[]
  user_aliases    UserFoodAlias[]
  review_logs     FoodReviewLog[]

  @@unique([name, category], name: "name_category") // seed upsert 用
  @@index([name]) // 普通索引；trigram GIN 索引见末尾 SQL
}

// ---------- 饮食记录 ----------
model FoodRecord {
  id                 String       @id @default(uuid())
  user_id            String
  food_id            String
  meal_type          MealType
  portion_label      PortionLabel
  weight_g           Float
  count              Float? // 可数份数（"两个"→2），AI 从原话提取；仅供餐食卡展示 `食物名 ×count`，不参与算账（T52，铁律 1）
  count_unit         String? // 与 count 配套的量词（个/碗/片/根）；count 为空时同为空
  calories           Float
  protein            Float
  fat                Float
  carbs              Float
  food_confidence    Float?
  portion_confidence Float?
  source             String       @default("text") // text | voice
  raw_input          String?
  parse_log_id       String?
  alias_canonical    String? // 若由用户食物直连(streak≥2)自动匹配，存匹配用的 canonical；供撤销/改食物联动清 alias streak（T30）
  predicted_grams    Float? // AI 原估克数（applyBias 之前）；隐式确认 job 与 discuss 偏差说明的 predicted 基准（T31）
  scene              String? // takeout | canteen | home | unknown，parser 从原话提取（T32）
  calories_source    String       @default("computed") // computed | user_override，modify.update change.calories 落库后置 user_override，防止后续 food×grams 重算覆盖（T40）
  calories_computed  Float? // calories_source=user_override 时，系统本会按 food×grams 算出的值（B轨偏差三元组的一角，T66）；存量记录与非 override 记录为空，不回填
  date               DateTime     @db.Date
  created_at         DateTime     @default(now())

  user User         @relation(fields: [user_id], references: [id])
  food FoodStandard @relation(fields: [food_id], references: [id])

  learning_events LearningEvent[]

  @@index([user_id, date])
}

// ---------- 运动记录 ----------
model ExerciseRecord {
  id              String   @id @default(uuid())
  user_id         String
  type            String
  duration_min    Int?
  calories_burned Float
  // T73：热量是用户自报的（"打球1小时烧了590卡"）还是 MET 估的。
  // 改时长时据此决定要不要按新时长重算——用户真值不该被 MET 估算覆盖。
  user_reported   Boolean  @default(false)
  source          String   @default("text")
  raw_input       String?
  date            DateTime @db.Date
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, date])
}

// ---------- 每日汇总缓存 ----------
model DailySummary {
  user_id         String
  date            DateTime @db.Date
  calories_in     Float    @default(0)
  bmr             Float    @default(0)
  tdee            Float    @default(0)
  exercise_out    Float    @default(0)
  total_out       Float    @default(0) // tdee + exercise_out
  deficit         Float    @default(0) // total_out - calories_in
  protein         Float    @default(0)
  fat             Float    @default(0)
  carbs           Float    @default(0)
  target_calories Float    @default(0)
  target_protein  Float    @default(0)
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@id([user_id, date])
}

// ---------- AI 解析日志 ----------
model AiParseLog {
  id            String   @id @default(uuid())
  user_id       String
  input_text    String
  parsed_json   Json?
  intent        String? // record | query | chat | modify | discuss | resolve（卡片点选）
  confidence    Float?
  status        String? // auto | pending | resolved | failed
  reply_summary String? // AI 回复摘要（T37 双向记忆）：模板回复直接存，自由回复截断 ~150 字
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

// ---------- 待用户确认 ----------
model PendingRecord {
  id         String   @id @default(uuid())
  user_id    String
  type       String // food_choice | portion_choice | clarify
  raw_input  String
  candidates Json
  status     String   @default("pending") // pending | resolved | discarded
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
}

// ---------- 学习系统（LEARNING_SPEC）----------
// 学习事件：预测 vs 实际，append-only。food_record/food_standard 可能被删/改，
// onDelete: SetNull 保留历史训练数据（不级联删）。
model LearningEvent {
  id              String   @id @default(uuid())
  user_id         String
  food_record_id  String?
  food_id         String?
  category        String? // 冗余存，更新 user_bias 时免 join
  scene           String? // takeout | canteen | home | unknown，T32 起有值
  predicted_grams Float // AI 原始估算（applyBias 之前）
  applied_grams   Float // applyBias 之后展示给用户的；T31 前 = predicted_grams
  final_grams     Float // 用户最终确定
  predicted_label String?
  final_label     String?
  signal_type     String // explicit_gram | custom_gram | card_choice | implicit_accept | delete
  signal_weight   Float
  log_ratio       Float? // ln(final/predicted)，训练用误差
  parse_log_id    String?
  created_at      DateTime @default(now())

  user        User           @relation(fields: [user_id], references: [id])
  food_record FoodRecord?    @relation(fields: [food_record_id], references: [id], onDelete: SetNull)
  food        FoodStandard?  @relation(fields: [food_id], references: [id], onDelete: SetNull)

  bias_updates BiasUpdateLog[]

  @@index([user_id, food_id, created_at])
}

// 体重历史：设置页改体重时后端顺手 append，供 T34 地面真值校准用
model WeightLog {
  user_id    String
  date       DateTime @db.Date
  weight_kg  Decimal
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@id([user_id, date])
}

// 三层偏差后验（LEARNING_SPEC §4 §5）：一行 = 一个 (scope, scope_key) 的正态后验（log 克数比）
model UserBias {
  user_id    String
  scope      String // food | category | scene
  scope_key  String // food_id / 类目名 / 场景名
  mu         Float    @default(0) // log-ratio 后验均值
  sigma2     Float    @default(0.09) // 后验方差（初始≈±35%不确定）
  n_eff      Float    @default(0) // 有效样本数（封顶 20，防僵化=防漂移）
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@id([user_id, scope, scope_key])
}

// 模型更新审计（可回放回滚、排查漂移；clamped 标记污染防护触发）
model BiasUpdateLog {
  id            String   @id @default(uuid())
  event_id      String
  user_id       String
  scope         String
  scope_key     String
  mu_before     Float
  sigma2_before Float
  n_eff_before  Float
  mu_after      Float
  sigma2_after  Float
  n_eff_after   Float
  clamped       Boolean  @default(false)
  created_at    DateTime @default(now())

  event LearningEvent @relation(fields: [event_id], references: [id])

  @@index([user_id, scope, scope_key, created_at])
}

// 估算食物复核日志（T33）：pro 重估的审计记录，兼幂等标记——该 food 有行即视为已复核，
// job 不再重复调用（updated 已改 source；rejected 留待人工复核，不自动重试）。
model FoodReviewLog {
  id            String   @id @default(uuid())
  food_id       String
  status        String // updated | rejected_energy_check | rejected_category_outlier
  old_values    Json // 复核前 {calories_100g, protein_100g, fat_100g, carbs_100g, fiber_100g}
  new_values    Json // pro 重估值，同上结构；rejected 时也存，供人工复核参考
  category_mean Float? // 判定时同类目标准层热量均值（无标准层条目时 null，跳过离群校验）
  ref_count     Int // 触发复核时的 food_record 引用次数
  model         String   @default("deepseek-v4-pro")
  created_at    DateTime @default(now())

  food FoodStandard @relation(fields: [food_id], references: [id])

  @@index([food_id])
}

// 用户食物直连：canonical → 用户惯用的 food_id，streak≥2 时跳过 CandidateCard（T30）
model UserFoodAlias {
  user_id        String
  canonical      String
  food_id        String
  hits           Int      @default(1)
  streak         Int      @default(1) // 连续选同一个的次数；选了别的/逃生口/撤销 → 清零
  last_chosen_at DateTime @default(now())

  user User         @relation(fields: [user_id], references: [id])
  food FoodStandard @relation(fields: [food_id], references: [id])

  @@id([user_id, canonical])
}

// ============================================================
// trigram 模糊匹配索引（Prisma schema 不直接支持 gin_trgm_ops，
// 在 migrate dev 后，手动建一条空迁移并加入以下 SQL，再 migrate）：
//
//   CREATE EXTENSION IF NOT EXISTS pg_trgm;
//   CREATE INDEX food_standard_name_trgm
//     ON "FoodStandard" USING gin (name gin_trgm_ops);
//
// 匹配查询示例（相似度阈值 0.3）：
//   SELECT *, similarity(name, $1) AS s
//   FROM "FoodStandard"
//   WHERE name % $1
//   ORDER BY s DESC
//   LIMIT 5;
// ============================================================

// ---------- 语义记忆（MEMORY_SPEC §6）----------
// 用户画像层：从对话提取的语义事实。score 不落库——检索时实时计算。
// embedding 用 Unsupported("vector(1024)") 因为 Prisma 不原生支持 pgvector 类型。
model UserMemory {
  id                String    @id @default(uuid())
  user_id           String
  type              String    // constraint | preference | habit | context_state | goal；CHECK 在迁移 SQL 里
  entity            String    // 归一化实体，优先使用受控词表（MEMORY_SPEC §4.3）
  content           String    // 人类可读文本，供 LLM 上下文注入
  llm_confidence    Float     // LLM 初始把握度（提取时记录，之后不变）
  importance_class  String    @default("normal") // medical | strong | normal | casual；LLM 分类 → 系统映射
  repetition_count  Int       @default(1) // 累计提及次数（24h 去重）
  state             String    @default("WEAK") // ACTIVE | WEAK | ARCHIVED
  source_type       String    @default("explicit_user") // explicit_user | implicit_behavior | system_inferred
  expires_at        DateTime? // 仅 type=goal 时可选：目标截止时间，过期后 decay × 0.2
  valid_from        DateTime  @default(now()) // 记忆开始有效的时间
  valid_to          DateTime? // 被矛盾记忆取代的时间（冲突处理时填写）
  embedding         Unsupported("vector(1024)")? // DeepSeek embedding（1024 维），preference/habit 语义检索用
  source_message_id String?   // 追溯：来源消息
  source_text       String?   // 追溯：原文片段
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  last_accessed_at  DateTime  @default(now()) // 上次被注入或更新的时间；decay 的 Δt 基准

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type, entity]) // 同 entity 只留一行：新措辞覆盖旧措辞（T74，MEMORY_SPEC §5.5 实现注记）
  @@index([user_id, state])
  @@index([user_id, last_accessed_at])
}

// ---------- 聊天记录（展示层，非事实源；保留约1年）----------
enum ChatRole {
  user
  assistant
}

model ChatMessage {
  id         String   @id @default(uuid())
  user_id    String
  date       DateTime @db.Date // 线程分组（按天）
  role       ChatRole
  kind       String   // text | record_card | meal_card | portion_card | candidate_card | clarify_card | query_card | exercise_card | weight_chart
  content    String?
  payload    Json?
  record_id  String? // 记录类卡片关联的 food_record，用于实时回填/删除联动
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, date, created_at])
}

// ---------- AI 行为追踪（Trace 系统）----------
model AiTrace {
  id                String   @id @default(uuid())
  user_id           String
  session_id        String?
  meal_id           String?
  input_text        String
  intent            String?
  status            String   @default("started") // started | ok | partial | failed
  model_used        String?
  model_upgraded    Boolean  @default(false)
  latency_ms        Int?
  token_usage       Json?
  error_info        Json?
  prompt_messages   Json?
  prompt_tools      Json?
  prompt_hash       String?
  state_snapshot    Json?
  created_at        DateTime @default(now())

  user   User           @relation(fields: [user_id], references: [id])
  events AiTraceEvent[]

  @@index([user_id, created_at(sort: Desc)])
  @@index([session_id])
  @@index([user_id, meal_id])
  @@index([prompt_hash])
}

model AiTraceEvent {
  id           String   @id @default(uuid())
  trace_id     String
  item_index   Int?
  seq          Int
  event_type   String   // parse | normalize | confidence | decision | output | correction | error
  state_before Json?
  state_after  Json?
  input_state  Json?
  output_state Json?
  meta         Json?
  created_at   DateTime @default(now())

  trace AiTrace @relation(fields: [trace_id], references: [id], onDelete: Cascade)

  @@index([trace_id, item_index, seq])
}

// ---------- Token 用量（计费数据源，独立于 AiTrace，不受 tracing 开关影响）----------
model TokenUsage {
  id                String   @id @default(uuid())
  user_id           String
  model             String   // deepseek-v4-flash | deepseek-v4-pro
  purpose           String   // parse | query | chat | discuss | estimate | adjudicate
  prompt_tokens     Int
  completion_tokens Int
  total_tokens      Int
  trace_id          String?  // 可选关联 AiTrace，用于排查单次请求成本（非外键，tracing 关闭时仍可写）
  created_at        DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, created_at(sort: Desc)])
  @@index([user_id, model])
}
